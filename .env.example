# ============ 数据生成 ============
# 通义千问 API（用于批量生成文旅指令数据）
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DATA_GEN_MODEL=qwen-plus

# ============ 推理服务 ============
# 基座模型 HuggingFace 路径
MODEL_PATH=Qwen/Qwen-7B-Chat
# LoRA 权重本地路径
LORA_PATH=./outputs/qwen-tourism-lora
# 服务监听
API_HOST=0.0.0.0
API_PORT=8000

# ============ 训练（AutoDL 上使用，本地不用）============
# 训练超参
LORA_RANK=8
LORA_ALPHA=32
LEARNING_RATE=2e-4
NUM_EPOCHS=3
BATCH_SIZE=4
GRAD_ACCUM=4
